{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "unit", "title", "xp", "card", "explain", "challenges", "takeaway"],
  "properties": {
    "id": { "type": "string", "pattern": "^[1-4]\\.[0-9]+\\.[0-9]+$" },
    "unit": { "type": "string", "pattern": "^[1-4]\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "xp": { "type": "integer", "minimum": 10, "maximum": 20 },
    "card": {
      "type": "object",
      "required": ["idea", "diagrams"],
      "properties": {
        "idea": { "type": "string", "maxLength": 400 },
        "diagrams": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "habit": { "type": "string" }
      }
    },
    "explain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["fen", "text"],
        "properties": {
          "fen": { "type": "string" },
          "text": { "type": "string", "maxLength": 420 },
          "arrows": { "type": "array" },
          "highlights": { "type": "array" }
        }
      }
    },
    "challenges": { "type": "array", "minItems": 5, "maxItems": 10, "items": { "$ref": "#/definitions/challenge" } },
    "takeaway": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "definitions": {
    "challenge": {
      "type": "object",
      "required": ["id", "type", "fen", "prompt", "concept"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": [
            "find_the_move",
            "find_the_sequence",
            "find_them_all",
            "is_it_safe",
            "which_square",
            "name_the_pattern",
            "play_it_out",
            "guess_the_move"
          ]
        },
        "fen": { "type": "string" },
        "prompt": { "type": "string", "maxLength": 200 },
        "concept": { "type": "string" },
        "hints": { "type": "object" },
        "reason": { "type": "string" },
        "answer": { "type": "object" },
        "wrong": { "type": "object" },
        "goal": {
          "type": "object",
          "required": ["kind", "moves"],
          "properties": {
            "kind": { "enum": ["mate_in", "promote", "capture_all", "hold"] },
            "moves": { "type": "integer", "minimum": 1 }
          }
        },
        "options": { "type": "array" },
        "reasons": { "type": "array" },
        "move": { "type": "string" },
        "commentary": { "type": "string" },
        "opponentDepth": { "type": "integer" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "find_them_all" } }, "required": ["type"] },
          "then": {
            "required": ["answer"],
            "properties": { "answer": { "$ref": "#/definitions/squaresOrPieces" } }
          }
        }
      ]
    },
    "squaresOrPieces": {
      "description": "design spec 4.7 / PRD 7.4: squares[] or pieces[]; a piece is named by the square it stands on",
      "type": "object",
      "oneOf": [{ "required": ["squares"] }, { "required": ["pieces"] }],
      "properties": {
        "squares": { "$ref": "#/definitions/squareList" },
        "pieces": { "$ref": "#/definitions/squareList" }
      }
    },
    "squareList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-h][1-8]$" }
    }
  }
}
