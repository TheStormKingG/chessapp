{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["unit", "title", "passMark", "sample", "bank"],
  "properties": {
    "unit": { "type": "string", "pattern": "^[1-4]\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "passMark": { "type": "number", "const": 0.75 },
    "sample": { "type": "integer", "minimum": 8, "maximum": 12 },
    "bank": { "type": "array", "minItems": 30, "items": { "$ref": "#/definitions/challenge" } }
  },
  "definitions": {
    "challenge": {
      "type": "object",
      "required": ["id", "type", "fen", "prompt", "concept"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": [
            "find_the_move",
            "find_the_sequence",
            "find_them_all",
            "is_it_safe",
            "which_square",
            "name_the_pattern",
            "play_it_out",
            "guess_the_move"
          ]
        },
        "fen": { "type": "string" },
        "prompt": { "type": "string", "maxLength": 200 },
        "concept": {
          "description": "design spec 2026-09-19 section 5: the enumerated concept vocabulary. CheckpointMachine draws a failed checkpoint's retry set from these tags (PRD 6.4), so a near-duplicate spelling splits a bank. Add a tag here in the same commit that first uses it.",
          "enum": [
            "absolute-pin",
            "attack-defend",
            "back-rank",
            "bishop-moves",
            "castling",
            "castling-restrictions",
            "check",
            "checkmate",
            "checks-and-captures",
            "corridor-mate",
            "counting",
            "damiano",
            "dont-hang",
            "draw-offer",
            "draws",
            "en-passant",
            "en-passant-timing",
            "escape-check",
            "escape-square",
            "family-fork",
            "files",
            "first-mistake",
            "fork-with-check",
            "habit-one",
            "hanging-both-sides",
            "keep-the-pin",
            "king-moves",
            "king-safe",
            "knight-fork",
            "knight-moves",
            "ladder-mate",
            "mate-in-one",
            "meeting-early-mates",
            "notation",
            "opponent-threats",
            "pawn-capture",
            "pawn-fork",
            "pawn-moves",
            "piece-safe",
            "pin-both-sides",
            "promotion",
            "queen-fork",
            "queen-mate",
            "queen-moves",
            "ranks",
            "relative-pin",
            "resigning",
            "rook-mate",
            "rook-moves",
            "sanity-check",
            "setup",
            "skewer",
            "smothered-mate",
            "square-names",
            "stalemate",
            "support-mate",
            "take-free",
            "the-clock",
            "threat-scan",
            "three-questions",
            "touch-move",
            "values"
          ]
        },
        "hints": { "type": "object" },
        "reason": { "type": "string" },
        "answer": { "type": "object" },
        "wrong": { "type": "object" },
        "goal": {
          "type": "object",
          "required": ["kind", "moves"],
          "properties": {
            "kind": { "enum": ["mate_in", "promote", "capture_all", "hold"] },
            "moves": { "type": "integer", "minimum": 1 }
          }
        },
        "options": { "type": "array" },
        "reasons": { "type": "array" },
        "move": { "type": "string" },
        "commentary": { "type": "string" },
        "opponentDepth": { "type": "integer" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "find_them_all" } }, "required": ["type"] },
          "then": {
            "required": ["answer"],
            "properties": { "answer": { "$ref": "#/definitions/squaresOrPieces" } }
          }
        }
      ]
    },
    "squaresOrPieces": {
      "description": "design spec 4.7 / PRD 7.4: squares[] or pieces[]; a piece is named by the square it stands on",
      "type": "object",
      "oneOf": [{ "required": ["squares"] }, { "required": ["pieces"] }],
      "properties": {
        "squares": { "$ref": "#/definitions/squareList" },
        "pieces": { "$ref": "#/definitions/squareList" }
      }
    },
    "squareList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-h][1-8]$" }
    }
  }
}
