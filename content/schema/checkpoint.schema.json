{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "unit",
    "title",
    "passMark",
    "sample",
    "bank"
  ],
  "properties": {
    "unit": {
      "type": "string",
      "pattern": "^[1-4]\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "passMark": {
      "type": "number",
      "const": 0.75
    },
    "sample": {
      "type": "integer",
      "minimum": 8,
      "maximum": 12
    },
    "bank": {
      "type": "array",
      "minItems": 30,
      "items": {
        "$ref": "#/definitions/challenge"
      }
    }
  },
  "definitions": {
    "challenge": {
      "type": "object",
      "required": [
        "id",
        "type",
        "fen",
        "prompt",
        "concept"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "find_the_move",
            "find_the_sequence",
            "find_them_all",
            "is_it_safe",
            "which_square",
            "name_the_pattern",
            "play_it_out",
            "guess_the_move"
          ]
        },
        "fen": {
          "type": "string"
        },
        "prompt": {
          "type": "string",
          "maxLength": 200
        },
        "concept": {
          "description": "design spec 2026-09-19 section 5: the enumerated concept vocabulary. CheckpointMachine draws a failed checkpoint's retry set from these tags (PRD 6.4), so a near-duplicate spelling splits a bank. Add a tag here in the same commit that first uses it.",
          "enum": ["absolute-pin", "advanced-pawn", "anastasia-mate", "arabian-mate", "attack-defend", "attack-signs", "back-rank", "battery", "bishop-moves", "blind-swine", "blunder-check", "boden-mate", "candidate-moves", "caro-kann", "castle-early", "castling", "castling-restrictions", "centre", "check", "checkmate", "checks-and-captures", "corridor-mate", "counting", "damiano", "deflection", "development", "discovered-attack", "discovered-check", "dont-hang", "double-check", "dovetail-mate", "draw-offer", "draws", "early-queen", "en-passant", "en-passant-timing", "epaulette-mate", "escape-check", "escape-square", "exploit-pin", "family-fork", "files", "first-mistake", "forcing-line", "fork-with-check", "four-elements", "greco-mate", "habit-one", "hanging-both-sides", "hook-mate", "insufficient-material", "italian", "keep-the-pin", "key-squares", "king-activity", "king-moves", "king-safe", "knight-fork", "knight-moves", "ladder-mate", "lolli-mate", "mate-in-one", "meeting-early-mates", "morphy-mate", "notation", "open-file", "opening-plans", "opera-mate", "opponent-threats", "opposition", "overloading", "passed-pawn", "pawn-capture", "pawn-fork", "pawn-moves", "pawn-storm", "pawn-weakness", "perpetual-check", "piece-activity", "piece-safe", "piece-twice", "pillsbury-mate", "pin-both-sides", "promotion", "promotion-race", "queen-fork", "queen-mate", "queen-moves", "queen-vs-pawn", "queens-gambit-declined", "ranks", "relative-pin", "removing-the-defender", "resigning", "rook-mate", "rook-moves", "rook-on-seventh", "rook-pawn-draw", "rook-vs-pawn", "rule-of-the-square", "sanity-check", "setup", "skewer", "smothered-mate", "square-names", "stalemate", "stalemate-defence", "story-game", "support-mate", "take-free", "target-position", "the-clock", "threat-scan", "three-questions", "touch-move", "trading", "trapped-piece", "under-promotion", "values", "when-to-draw", "x-ray"]
        },
        "hints": {
          "type": "object"
        },
        "reason": {
          "type": "string"
        },
        "answer": {
          "type": "object"
        },
        "wrong": {
          "type": "object"
        },
        "goal": {
          "type": "object",
          "required": [
            "kind",
            "moves"
          ],
          "properties": {
            "kind": {
              "enum": [
                "mate_in",
                "promote",
                "capture_all",
                "hold"
              ]
            },
            "moves": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "options": {
          "type": "array"
        },
        "reasons": {
          "type": "array"
        },
        "move": {
          "type": "string"
        },
        "commentary": {
          "type": "string"
        },
        "opponentDepth": {
          "type": "integer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "find_them_all"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "answer"
            ],
            "properties": {
              "answer": {
                "$ref": "#/definitions/squaresOrPieces"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "guess_the_move"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "commentary"
            ],
            "properties": {
              "commentary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "squaresOrPieces": {
      "description": "design spec 4.7 / PRD 7.4: squares[] or pieces[]; a piece is named by the square it stands on",
      "type": "object",
      "oneOf": [
        {
          "required": [
            "squares"
          ]
        },
        {
          "required": [
            "pieces"
          ]
        }
      ],
      "properties": {
        "squares": {
          "$ref": "#/definitions/squareList"
        },
        "pieces": {
          "$ref": "#/definitions/squareList"
        }
      }
    },
    "squareList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-h][1-8]$"
      }
    }
  }
}
